{
  "name": "sidervale",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "harvest": "tsx tools/dataset/harvest-darksky.ts && tsx tools/dataset/harvest-rasc.ts",
    "test:tools": "vitest run tools/dataset",
    "merge": "tsx tools/dataset/merge-sites.ts",
    "enrich": "tsx tools/dataset/enrich-sites.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "suncalc": "2.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.7.2",
    "@types/suncalc": "^1.9.2",
    "@types/tz-lookup": "^6.1.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "tz-lookup": "^6.1.25",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
